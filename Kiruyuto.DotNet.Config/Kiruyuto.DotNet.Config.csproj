<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <!-- Package Metadata -->
    <PackageId>Kiruyuto.DotNet.Config</PackageId>
    <Title>Kiruyuto's .NET Code style and config</Title>
    <Version>3.0.1</Version>
    <Authors>Kiruyuto</Authors>
    <Description>A personal NuGet package containing rules and analyzers to share .NET code style and configuration across multiple projects.</Description>
    <PackageIcon>logo-transparent-bg.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Kiruyuto/.NET-Config</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Kiruyuto/.NET-Config.git</RepositoryUrl>
    <RepositoryBranch>master</RepositoryBranch>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzers and Dependencies -->
    <PackageReference Include="AsyncFixer" Version="2.1.0" PrivateAssets="none"/>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.32.0.713" PrivateAssets="none"/>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="none"/>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="none"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Package Content Files -->
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
    <None Include="..\LICENSE" Pack="true" PackagePath="\"/>
    <None Include="resources\logo-transparent-bg.png" Pack="true" PackagePath="\"/>

    <!-- https://learn.microsoft.com/en-us/nuget/reference/errors-and-warnings/nu5127 -->
    <!-- This marker makes NuGet reject consumers targeting frameworks older than .NET 10. -->
    <!-- The packaged build target rejects future .NET versions and non-C# projects after restore. -->
    <None Include="packaging\_._" Pack="true" PackagePath="lib\net10.0\_._"/>

    <None Include="build\**" Pack="true" PackagePath="build\net10.0\"/>
    <None Include="files\**" Pack="true" PackagePath="files\"/>
  </ItemGroup>
</Project>