<Project>
  <PropertyGroup Label="Banned API configuration">
    <KiruyutoDotNetConfigEnableEntityFrameworkCoreAsyncAddBans Condition="'$(KiruyutoDotNetConfigEnableEntityFrameworkCoreAsyncAddBans)' == ''">true</KiruyutoDotNetConfigEnableEntityFrameworkCoreAsyncAddBans>
  </PropertyGroup>

  <ItemGroup Label="Register analyzer configuration files and additional files">
    <!-- Register the editor/global config files -->
    <!-- This path is relative to packed directory structure -->
    <!-- Note that "MSBuildThisFileDirectory" comes with a trailing slash already -->
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\..\files\*.globalconfig" />

    <!-- IDE0130 requires these project properties during command-line analysis. -->
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
    
    <!-- Register Banned Symbols -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\files\BannedSymbols.txt" Visible="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\files\BannedSymbols.EntityFrameworkCore.txt" Condition="'$(KiruyutoDotNetConfigEnableEntityFrameworkCoreAsyncAddBans)' == 'true'" Visible="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\files\vs-threading.SyncMethodsToExcludeFromVSTHRD103.EntityFrameworkCore.txt" Condition="'$(KiruyutoDotNetConfigEnableEntityFrameworkCoreAsyncAddBans)' == 'true'" Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="Analyzer related settings">
    <!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/overview?#enable-additional-rules -->
    <AnalysisLevel>10-all</AnalysisLevel>

    <!-- https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/compiler-options/errors-warnings#reportanalyzer -->
    <ReportAnalyzer>true</ReportAnalyzer>

    <!-- https://github.com/dotnet/runtime/issues/27005#issuecomment-408646070 -->
    <Features>strict</Features>

    <!-- https://learn.microsoft.com/en-us/visualstudio/code-quality/install-net-analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/overview?#enable-on-build -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

  </PropertyGroup>
</Project>