<Project>
  <!-- Enable runtime async after the consuming project has been evaluated. -->
  <!-- https://learn.microsoft.com/en-us/dotnet/core/whats-new/dotnet-11/runtime#runtime-async -->
  <PropertyGroup Label="Runtime async">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- Compiler feature changes must invalidate incremental compilation. -->
  <ItemGroup>
    <CoreCompileCache Include="$(Features)" />
  </ItemGroup>

  <Target Name="KiruyutoDotNetConfigValidateCompatibility" BeforeTargets="PrepareForBuild" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Error Code="KDC1001"
      Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp' OR '$(TargetFrameworkVersion)' != 'v11.0'"
      Text="Kiruyuto.DotNet.Config supports only .NET 11 target frameworks (net11.0 and platform-specific net11.0 TFMs). Project '$(MSBuildProjectName)' targets '$(TargetFramework)'."
    />
    <Error Code="KDC1002"
      Condition="'$(Language)' != 'C#'"
      Text="Kiruyuto.DotNet.Config supports only C# projects. Project '$(MSBuildProjectName)' uses '$(Language)'."
    />
  </Target>
</Project>