<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncFixer" Version="2.1.0" GeneratePathProperty="true" />
    <PackageReference Include="Basic.Reference.Assemblies.Net110" Version="1.8.15" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="TUnit" Version="1.83.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AsyncFixer">
      <HintPath>$(PkgAsyncFixer)\analyzers\dotnet\cs\AsyncFixer.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\Kiruyuto.DotNet.Config\files\AsyncFixer.globalconfig" Link="Configurations\AsyncFixer.globalconfig" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="AsyncFixer\" />
    <Folder Include="BannedSymbols\" />
  </ItemGroup>
</Project>
